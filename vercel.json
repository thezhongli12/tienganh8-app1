{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/app.js" },
    { "source": "/study", "destination": "/views/study.html" },
    { "source": "/login", "destination": "/views/login.html" },
    { "source": "/register", "destination": "/views/register.html" },
    { "source": "/", "destination": "/views/index.html" },
    { "source": "/(.*)", "destination": "/app.js" }
  ]
}
